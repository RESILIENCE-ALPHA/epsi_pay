# Base de données PostgreSQL 15
POSTGRES_USER=epsi_pay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=epsi_pay_db
POSTGRES_PORT=5432

# URL de connexion complète
DATABASE_URL="postgresql://epsi_pay:CHANGE_ME@localhost:5432/epsi_pay_db?schema=public"

# Ports des services
API_PORT=3000
AUTH_PORT=3001
PAYMENT_PORT=3002
FRONT_PORT=8080

# Environnement
NODE_ENV=development

# Seed de la base de données (10k ou standard)
SEED_TYPE=10k

# Sécurité Auth
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
