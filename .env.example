# Configuration de la base de données PostgreSQL 15 (partagée par auth et payment)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epsi_pay_db
DB_USER=epsi_pay
DB_PASSWORD=epsi_pay_secret

# Port HTTP du service (auth et payment écoutent sur 3000 dans leur conteneur)
PORT=3000

# Environnement (development, test, production)
NODE_ENV=development

# --- database (seeder) ---
# seed-10k (défaut, ignoré si déjà peuplé) ou seed (jeu minimal, vide les tables)
SEED_SCRIPT=seed-10k
# Mot de passe de tous les comptes seedés
SEED_USER_PASSWORD=Password123!

# --- auth ---
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
SESSION_TTL_MINUTES=60
# Proxies de confiance pour X-Forwarded-For : nombre ou CIDR (défaut 1 = nginx du frontend, vide = désactivé)
# TRUST_PROXY=1

# --- payment ---
# Secret partagé avec le moteur de remédiation pour POST /payments/test-validation (vide = route désactivée)
INTERNAL_API_TOKEN=
SYSTEM_BOT_EMAIL=system-bot@epsi-pay.internal
