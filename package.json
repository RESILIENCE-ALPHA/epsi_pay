{
  "name": "epsi-pay",
  "version": "1.0.0",
  "description": "Plateforme de paiement résiliente - Project RESILIENCE-ALPHA",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start:api": "tsx api/src/server.ts",
    "test": "vitest run",
    "test:api": "vitest run api/src/__tests__",
    "test:db": "vitest run database/__tests__",
    "db:init": "tsx database/init.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=database/prisma/schema.prisma",
    "db:seed": "tsx database/prisma/seed.ts",
    "db:seed:10k": "tsx database/prisma/seed-10k.ts",
    "db:setup": "docker compose up -d && prisma db push --schema=database/prisma/schema.prisma && tsx database/prisma/seed-10k.ts"
  },
  "keywords": [
    "payment",
    "resilience",
    "workshop"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "tsx database/prisma/seed.ts"
  }
}
